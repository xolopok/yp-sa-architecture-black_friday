!procedure $cdnRegion1()
Container(cdn_edge_1, "cdn_edge_1: Edge-сервер CDN, регион 1", "CDN (HTTP Proxy)", "Кэширует статический контент")
!endprocedure

!procedure $cdnRegion2()
Container(cdn_edge_2, "cdn_edge_2: Edge-сервер CDN, регион 2", "CDN (HTTP Proxy)", "Кэширует статический контент")
!endprocedure

!procedure $cdnZone()
System_Boundary(cdnZone, "CDN") {
    $cdnRegion1()
    $cdnRegion2()
}
!endprocedure
