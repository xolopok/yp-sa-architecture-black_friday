!procedure $cfg3()
ContainerDb(cfg_3, "db_cfg_3: Конфигурация БД 3", "MongoDB/mongod", "Хранит метаданные кластера БД")
!endprocedure

!procedure $cfgRs()
$cfg1()
$cfg2()
$cfg3()
!endprocedure

